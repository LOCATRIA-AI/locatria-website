{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.locatria.com/schemas/tool.schema.json",
  "title": "Locatria Canonical Tool Schema",
  "description": "Defines a software tool entity evaluated within LOCATRIA knowledge workflows.",
  "type": "object",
  "required": [
    "entity_type",
    "schema_version",
    "tool_id",
    "tool_name",
    "provider",
    "official_url",
    "classification",
    "problem",
    "workflow",
    "commercial",
    "lifecycle_status",
    "governance"
  ],
  "properties": {
    "entity_type": {
      "type": "string",
      "const": "tool"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    },
    "tool_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "tool_name": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "official_url": {
      "type": "string",
      "format": "uri"
    },
    "classification": {
      "type": "object",
      "required": [
        "primary_capability",
        "secondary_capabilities",
        "target_users",
        "target_verticals"
      ],
      "properties": {
        "primary_capability": {
          "type": "string",
          "minLength": 1
        },
        "secondary_capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "target_users": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "target_verticals": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "problem": {
      "type": "object",
      "required": [
        "primary_problem",
        "secondary_problems",
        "use_cases"
      ],
      "properties": {
        "primary_problem": {
          "type": "string",
          "minLength": 1
        },
        "secondary_problems": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "use_cases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": [
        "supported_workflows",
        "workflow_stages",
        "required_capabilities"
      ],
      "properties": {
        "supported_workflows": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "workflow_stages": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "commercial": {
      "type": "object",
      "required": [
        "pricing_model",
        "free_plan",
        "affiliate_available"
      ],
      "properties": {
        "pricing_model": {
          "type": "string",
          "enum": [
            "FREE",
            "FREEMIUM",
            "SUBSCRIPTION",
            "USAGE_BASED",
            "TIERED",
            "ONE_TIME",
            "CUSTOM"
          ]
        },
        "free_plan": {
          "type": "boolean"
        },
        "affiliate_available": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "DISCOVERED",
        "UNDER_REVIEW",
        "EVALUATED",
        "LISTED",
        "CONDITIONALLY_RECOMMENDED",
        "RECOMMENDED",
        "NOT_RECOMMENDED",
        "RETIRED"
      ]
    },
    "governance": {
      "type": "object",
      "required": [
        "last_reviewed",
        "reviewer",
        "review_status",
        "change_notes"
      ],
      "properties": {
        "last_reviewed": {
          "type": "string",
          "format": "date"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "type": "string",
          "minLength": 1
        },
        "change_notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
