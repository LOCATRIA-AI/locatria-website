{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.locatria.com/schemas/resource.schema.json",
  "title": "Locatria Canonical Resource Schema",
  "description": "Defines an operational resource or guide entity in the LOCATRIA Resource Layer.",
  "type": "object",
  "required": [
    "entity_type",
    "schema_version",
    "resource_id",
    "resource_title",
    "resource_type",
    "description",
    "problem",
    "workflow",
    "governance"
  ],
  "properties": {
    "entity_type": {
      "type": "string",
      "const": "resource"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "resource_title": {
      "type": "string",
      "minLength": 1
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "RESOURCE_GUIDE",
        "WORKFLOW_RESOURCE",
        "TOOL_PROFILE"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "problem": {
      "type": "object",
      "required": [
        "problem_statement",
        "target_users",
        "target_verticals"
      ],
      "properties": {
        "problem_statement": {
          "type": "string",
          "minLength": 1
        },
        "target_users": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "target_verticals": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": [
        "workflow_name",
        "workflow_stage",
        "required_capabilities"
      ],
      "properties": {
        "workflow_name": {
          "type": "string",
          "minLength": 1
        },
        "workflow_stage": {
          "type": "string",
          "minLength": 1
        },
        "required_capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "related_tools": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "related_articles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_learning_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "governance": {
      "type": "object",
      "required": [
        "last_reviewed",
        "review_status",
        "reviewer",
        "change_notes"
      ],
      "properties": {
        "last_reviewed": {
          "type": "string",
          "format": "date"
        },
        "review_status": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "change_notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
