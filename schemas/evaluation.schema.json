{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.locatria.com/schemas/evaluation.schema.json",
  "title": "Locatria Canonical Evaluation Schema",
  "description": "Defines qualitative multi-dimensional evaluation of a tool without numeric scoring.",
  "type": "object",
  "required": [
    "entity_type",
    "schema_version",
    "evaluation_id",
    "tool_id",
    "dimensions",
    "evidence_refs",
    "evaluated_by",
    "evaluated_at"
  ],
  "properties": {
    "entity_type": {
      "type": "string",
      "const": "evaluation"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    },
    "evaluation_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "tool_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "dimensions": {
      "type": "object",
      "required": [
        "problem_fit",
        "workflow_fit",
        "usability",
        "capability",
        "evidence",
        "integration",
        "value",
        "limitations"
      ],
      "properties": {
        "problem_fit": {
          "type": "string",
          "minLength": 1
        },
        "workflow_fit": {
          "type": "string",
          "minLength": 1
        },
        "usability": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "integration": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "evaluated_by": {
      "type": "string",
      "minLength": 1
    },
    "evaluated_at": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string"
    },
    "governance": {
      "type": "object",
      "properties": {
        "review_status": { "type": "string" },
        "last_reviewed": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
