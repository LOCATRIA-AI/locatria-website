{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.locatria.com/schemas/visibility/audit-log.schema.json",
  "title": "LOCATRIA Visibility Audit Log Schema",
  "description": "Defines an immutable audit entry recording actions, state transitions, corrections, and Founder decisions in the LOCATRIA Visibility Operating System.",
  "type": "object",
  "required": [
    "entity_type",
    "schema_version",
    "audit_id",
    "actor",
    "actor_type",
    "action",
    "entity_type_target",
    "entity_id",
    "timestamp",
    "reason"
  ],
  "properties": {
    "entity_type": {
      "type": "string",
      "const": "audit_log"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    },
    "audit_id": {
      "type": "string",
      "pattern": "^AUD-[A-Za-z0-9_-]+$"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "actor_type": {
      "type": "string",
      "enum": [
        "FOUNDER",
        "ADMIN_OPERATOR",
        "AI_ADVISOR",
        "MEASUREMENT",
        "IMPLEMENTATION",
        "QA",
        "SYSTEM"
      ]
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "entity_type_target": {
      "type": "string",
      "minLength": 1
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "before": {
      "type": ["object", "null"]
    },
    "after": {
      "type": ["object", "null"]
    },
    "timestamp": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
