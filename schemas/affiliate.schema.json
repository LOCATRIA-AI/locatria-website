{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.locatria.com/schemas/affiliate.schema.json",
  "title": "Locatria Canonical Affiliate Schema",
  "description": "Defines commercial affiliate metadata strictly decoupled from tool evaluation.",
  "type": "object",
  "required": [
    "entity_type",
    "schema_version",
    "affiliate_id",
    "tool_id",
    "affiliate_available",
    "status"
  ],
  "properties": {
    "entity_type": {
      "type": "string",
      "const": "affiliate"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    },
    "affiliate_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "tool_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "affiliate_available": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "NONE",
        "PENDING",
        "ACTIVE",
        "PAUSED",
        "ENDED"
      ]
    },
    "program": {
      "type": "string"
    },
    "network": {
      "type": "string"
    },
    "affiliate_url": {
      "type": "string",
      "format": "uri"
    },
    "disclosure_required": {
      "type": "boolean"
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
