{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.locatria.com/schemas/affiliate.schema.json",
  "title": "Locatria Canonical Affiliate Schema",
  "description": "Defines commercial affiliate metadata strictly decoupled from tool evaluation.",
  "type": "object",
  "required": [
    "entity_type",
    "schema_version",
    "affiliate_id",
    "tool_id",
    "affiliate_available",
    "status"
  ],
  "properties": {
    "entity_type": {
      "type": "string",
      "const": "affiliate"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    },
    "affiliate_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "tool_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "affiliate_available": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "NONE",
        "PENDING",
        "ACTIVE",
        "PAUSED",
        "ENDED"
      ]
    },
    "program": {
      "type": "string"
    },
    "network": {
      "type": "string"
    },
    "affiliate_url": {
      "type": "string",
      "format": "uri"
    },
    "disclosure_required": {
      "type": "boolean"
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "affiliate_program_available": {
      "type": "string",
      "enum": [
        "TRUE",
        "FALSE",
        "UNKNOWN"
      ]
    },
    "locatria_affiliate_relationship": {
      "type": "string",
      "enum": [
        "NOT_CONTRACTED",
        "PENDING",
        "ACTIVE",
        "ENDED"
      ]
    },
    "affiliate_activation_status": {
      "type": "string",
      "enum": [
        "NOT_ACTIVATED",
        "ACTIVATED",
        "PAUSED",
        "ENDED"
      ]
    },
    "destination_url": {
      "type": "string",
      "format": "uri"
    },
    "program_source_url": {
      "type": "string",
      "format": "uri"
    },
    "responsible_owner": {
      "type": "string"
    },
    "date_applied": {
      "type": "string",
      "format": "date"
    },
    "date_activated": {
      "type": "string",
      "format": "date"
    },
    "date_paused_ended": {
      "type": "string",
      "format": "date"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "PENDING_CHECK"
      ]
    }
  },
  "additionalProperties": false
}
